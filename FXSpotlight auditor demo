            <G style={{ padding: "20px 24px", marginBottom: 16, display: "flex", justifyContent: "space-between", alignItems: "center" }}>
              <div style={{ fontSize: 12, color: "rgba(255,255,255,0.5)" }}>Would an institutional trader take this?</div>
              <div style={{ fontFamily: "'Syne', sans-serif", fontWeight: 800, fontSize: 16, color: result.would_institutional_take ? "#4ade80" : "#f87171" }}>
                {result.would_institutional_take ? "YES" : "NO"}
              </div>
            </G>

            {/* Strengths + Risks */}
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginBottom: 12 }}>
              <G style={{ padding: "24px" }}>
                <div style={{ fontSize: 9, color: "#4ade80", letterSpacing: "3px", marginBottom: 16 }}>STRENGTHS</div>
                {result.strengths.map((s, i) => (
                  <div key={i} style={{ display: "flex", gap: 12, marginBottom: 12 }}>
                    <div style={{ color: "#4ade80", flexShrink: 0, fontSize: 14 }}>✓</div>
                    <div style={{ fontSize: 12, color: "rgba(255,255,255,0.5)", lineHeight: 1.6 }}>{s}</div>
                  </div>
                ))}
              </G>
              <G style={{ padding: "24px" }}>
                <div style={{ fontSize: 9, color: "#f87171", letterSpacing: "3px", marginBottom: 16 }}>RISKS</div>
                {result.risks.map((r, i) => (
                  <div key={i} style={{ display: "flex", gap: 12, marginBottom: 12 }}>
                    <div style={{ color: "#f87171", flexShrink: 0, fontSize: 14 }}>⚠</div>
                    <div style={{ fontSize: 12, color: "rgba(255,255,255,0.5)", lineHeight: 1.6 }}>{r}</div>
                  </div>
                ))}
              </G>
            </div>

            {/* What to fix */}
            <G style={{ padding: "24px", marginBottom: 12, borderLeft: "3px solid #facc15" }}>
              <div style={{ fontSize: 9, color: "#facc15", letterSpacing: "3px", marginBottom: 10 }}>WHAT TO FIX</div>
              <div style={{ fontSize: 13, color: "rgba(255,255,255,0.6)", lineHeight: 1.7 }}>{result.what_to_fix}</div>
            </G>

            {/* Coaching note */}
            <G style={{ padding: "28px", marginBottom: 24, textAlign: "center" }}>
              <div style={{ fontSize: 9, color: "rgba(255,255,255,0.2)", letterSpacing: "3px", marginBottom: 12 }}>COACHING NOTE</div>
              <div style={{ fontSize: 16, color: "rgba(255,255,255,0.7)", lineHeight: 1.8, fontStyle: "italic" }}>
                "{result.coaching_note}"
              </div>
              <div style={{ marginTop: 16, fontSize: 10, color: "rgba(255,255,255,0.15)", letterSpacing: "2px" }}>
                — FXSpotlight AI COACH
              </div>
            </G>

            {/* Actions */}
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 }}>
              <button onClick={reset} style={{
                padding: "18px", borderRadius: 14,
                background: "rgba(255,255,255,0.06)", color: "#fff",
                border: "1px solid rgba(255,255,255,0.1)",
                cursor: "pointer", fontSize: 11, fontFamily: mono,
                letterSpacing: "2px", transition: "all 0.2s",
              }}>AUDIT ANOTHER TRADE</button>
              <a href="https://spotlightfx.gumroad.com/l/hrlfi" target="_blank" rel="noopener noreferrer" style={{
                padding: "18px", borderRadius: 14,
                background: "#fff", color: "#000",
                border: "none", cursor: "pointer",
                fontSize: 11, fontFamily: mono,
                letterSpacing: "2px", textDecoration: "none",
                display: "flex", alignItems: "center", justifyContent: "center",
              }}>GET FOUNDER ACCESS →</a>
            </div>

            {/* Footer */}
            <div style={{ textAlign: "center", marginTop: 32, fontSize: 10, color: "rgba(255,255,255,0.1)", letterSpacing: "3px", lineHeight: 2 }}>
              FXSPOTLIGHT · DECISION ENFORCEMENT FOR SERIOUS TRADERS<br />
              PROCESS OVER PROFITS · EVERY TIME
            </div>
          </div>
        )}
      </div>

      <style>{`
        @keyframes spin { to { transform: rotate(360deg); } }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        input, textarea, select { color-scheme: dark; }
        input:focus, textarea:focus, select:focus { border-color: rgba(255,255,255,0.25) !important; }
        select option { background: #111; color: #fff; }
        ::-webkit-scrollbar { width: 3px; }
        ::-webkit-scrollbar-track { background: #000; }
        ::-webkit-scrollbar-thumb { background: #222; border-radius: 2px; }
        button:hover { opacity: 0.85; }
      `}</style>
    </div>
  );
}
